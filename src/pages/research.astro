---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/PageIntro.astro";
import ResearchThread from "@components/ResearchThread.astro";
import { researchThreads } from "@data/research";
---

<BaseLayout title="Research" description="Research interests and threads by Haojie Hu.">
  <PageIntro
    eyebrow="Research"
    title="Questions I keep returning to, from different angles."
    copy="My research sits around multimodal evidence, reasoning budgets, and AI systems that make their intermediate decisions visible enough to challenge."
  />

  <section class="thread-stack">
    {researchThreads.map((thread) => <ResearchThread thread={thread} />)}
  </section>
</BaseLayout>
