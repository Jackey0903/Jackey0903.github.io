---
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";
import { projects } from "@data/projects";
---

<BaseLayout
  title="Projects"
  description="Research code, agent workflows, and engineering systems built by Haojie Hu."
>
  <h1 class="page__title">&#128640; Projects</h1>
  <div class="prose">
    <p>
      Research code, agent workflows, and engineering systems built through
      research, competitions, and coursework. Publications live on the{" "}
      <a href="/#publications">homepage</a>.
    </p>
  </div>

  {
    projects.map((project) => (
      <article class="project-card">
        <div class="project-card__media">
          {
            project.image ? (
              <a href={project.image.src} aria-label={`Preview: ${project.title}`}>
                <img class="entry__thumb" src={project.image.src} alt={project.image.alt} loading="lazy" width="176" height="108" />
              </a>
            ) : (
              <div class="entry__placeholder" aria-hidden="true">{project.placeholder ?? project.title}</div>
            )
          }
        </div>
        <div class="project-card__body">
        <div class="project-card__head">
          <h2 class="project-card__title">
            <a href={project.repo}>{project.title}</a>
          </h2>
          <span class="project-card__meta">
            {project.period} &middot; {project.role}
          </span>
        </div>
        <p class="project-card__subtitle">{project.subtitle}</p>
        <div class="prose">
          <p>{project.summary}</p>
          <ul>
            {project.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </div>
        <p class="entry__venue">{project.status}</p>
        <ul class="tag-row">
          {project.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <p class="entry__links">
          <a class="entry__link" href={project.repo}>Code</a>
          {(project.links ?? []).map((link) => (
            <a class="entry__link" href={link.href}>{link.label}</a>
          ))}
        </p>
        </div>
      </article>
    ))
  }

  <p class="prose">
    <a class="text-link" href="/">Back to homepage <Icon name="arrow" /></a>
  </p>
</BaseLayout>
