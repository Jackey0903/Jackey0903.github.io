---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/PageIntro.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { projects } from "@data/projects";
---

<BaseLayout title="Projects" description="Selected research and software projects by Haojie Hu.">
  <PageIntro
    eyebrow="Projects"
    title="Selected Projects"
    copy="Research code, agent workflows, and engineering systems developed through research, competitions, and coursework."
  />

  <section class="project-list project-list-full">
    {projects.map((project) => <ProjectCard project={project} />)}
  </section>
</BaseLayout>
