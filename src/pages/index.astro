---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { featuredProjects } from "@data/projects";
import { site } from "@data/site";
import { ArrowUpRight } from "@lucide/astro";
---

<BaseLayout>
  <article class="academic-home reveal">
    <header class="content-header">
      <p class="eyebrow">Biography</p>
      <h1>About Me</h1>
      <p class="page-lead">
        I am <strong>Haojie Hu</strong>, a Software Engineering undergraduate at
        <a href={site.links.tongji}>Tongji University</a> working at the intersection
        of AI research and engineering.
      </p>
    </header>

    <div class="academic-copy">
      <p>
        My research explores how intelligent systems connect auditory, visual,
        and linguistic evidence. I am particularly interested in models that can
        ground their decisions in observable signals rather than rely on surface-level correlations.
      </p>
      <p>
        Recent projects study physically consistent audio-visual segmentation,
        reasoning budgets before multimodal grounding, and multi-agent systems for
        scientific communication. I enjoy turning research questions into reproducible
        systems whose behavior can be inspected and improved.
      </p>
    </div>

    <section class="academic-section">
      <h2>Research Interests</h2>
      <ul class="research-interest-list">
        <li>
          <strong>Multimodal Perception.</strong>{" "}
          Audio-visual learning, motion-aware grounding, and physically consistent segmentation.
        </li>
        <li>
          <strong>Reasoning and Grounding.</strong>{" "}
          Understanding when explicit reasoning helps perception and when it introduces drift.
        </li>
        <li>
          <strong>AI for Research.</strong>{" "}
          Agent workflows that make scientific content easier to understand, edit, and evaluate.
        </li>
      </ul>
    </section>

    <section class="academic-section news-section reveal reveal-delay-1">
      <h2>News</h2>
      <ol class="news-list">
        <li>
          <time datetime="2026-08">Aug 2026</time>
          <p><strong>PosterMELD</strong> released its paper, code, and evaluation benchmark for editable scientific poster generation.</p>
        </li>
        <li>
          <time datetime="2026-08">Aug 2026</time>
          <p><strong>DraftCode</strong> placed third at the AWS Summit Shanghai hackathon and advanced to the Macau round.</p>
        </li>
        <li>
          <time datetime="2026">2026</time>
          <p>Released the reproducible <strong>To Think or Not to Think</strong> codebase for reasoning-budget studies in Ref-AVS.</p>
        </li>
      </ol>
    </section>

    <section class="academic-section selected-section">
      <div class="section-heading reveal">
        <h2>Selected Projects</h2>
        <a class="text-link" href="/projects/">All projects <ArrowUpRight size={15} aria-hidden="true" /></a>
      </div>
      <div class="project-list">
        {featuredProjects.map((project) => <ProjectCard project={project} compact />)}
      </div>
    </section>

    <section class="academic-section opportunity-note reveal">
      <h2>Current Opportunities</h2>
      <p>
        I am interested in AI research and engineering internships involving multimodal systems,
        LLM reasoning, agents, or evaluation-focused AI.
      </p>
      <a class="text-link" href={site.links.email}>Contact me <ArrowUpRight size={15} aria-hidden="true" /></a>
    </section>
  </article>
</BaseLayout>
