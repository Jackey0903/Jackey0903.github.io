---
import BaseLayout from "@layouts/BaseLayout.astro";
import Entry from "@components/Entry.astro";
import Icon from "@components/Icon.astro";
import { site } from "@data/site";
import { education, honors, interests, skills } from "@data/profile";
import { news } from "@data/news";
import { publicationGroups } from "@data/publications";
import { featuredProjects } from "@data/projects";
---

<BaseLayout>
  <h1 class="page__title" id="about">&#128173; About me</h1>
  <div class="prose">
    <p>
      I am an undergraduate student in Software Engineering at{" "}
      <a href={site.links.tongji}>Tongji University</a>, Shanghai. I study how AI
      systems listen, look, reason, and revise - and I build tools that make
      those decisions easier to inspect.
    </p>
    <p>
      My work so far spans physically consistent audio-visual segmentation,
      reasoning budgets before multimodal grounding, and multi-agent systems for
      scientific communication. I like research questions whose failures are
      visible, and pipelines that keep their intermediate artifacts open to
      disagreement. My research interests include:
    </p>
    <ul>
      {
        interests.map((interest) => (
          <li>
            <strong>{interest.label}:</strong> {interest.detail}
          </li>
        ))
      }
    </ul>
  </div>

  <h2 class="section__title" id="education">&#128214; Education</h2>
  <div class="prose">
    <ul>
      {
        education.map((entry) => (
          <li>
            {entry.period}: {entry.degree},{" "}
            {entry.institutionUrl ? (
              <a href={entry.institutionUrl}>{entry.institution}</a>
            ) : (
              entry.institution
            )}
            {entry.note ? `, ${entry.note}.` : "."}
          </li>
        ))
      }
    </ul>
  </div>

  <h2 class="section__title" id="news">&#128293; News</h2>
  <ul class="news-list">
    {
      news.map((item) => (
        <li>
          <span class="news-date">[{item.date}]</span>
          {item.href ? (
            <a class="news-highlight" href={item.href}>{item.highlight}</a>
          ) : (
            <span class="news-highlight">{item.highlight}</span>
          )}{" "}
          {item.body}
        </li>
      ))
    }
  </ul>

  <h2 class="section__title" id="publications">&#128221; Publications</h2>
  {
    publicationGroups.map((group) => (
      <>
        <h3 class="group__title">{group.heading}</h3>
        {group.entries.map((entry) => (
          <Entry
            title={entry.title}
            href={entry.href}
            authors={entry.authors}
            venue={entry.venue}
            summary={entry.summary}
            links={entry.links}
            image={entry.image}
          />
        ))}
      </>
    ))
  }

  <h2 class="section__title" id="projects">
    <span>&#128640; Projects</span>
    <a class="text-link section__aside" href="/projects/">
      All projects <Icon name="arrow" />
    </a>
  </h2>
  {
    featuredProjects.map((project) => (
      <Entry
        title={project.title}
        href={project.repo}
        venue={`${project.period} \u00b7 ${project.role} \u00b7 ${project.status}`}
        summary={project.summary}
        links={[{ label: "Code", href: project.repo }, ...(project.links ?? [])]}
        image={project.image}
        placeholder={project.placeholder}
      />
    ))
  }

  <h2 class="section__title" id="honors">&#127894; Honors and Awards</h2>
  <ul class="definition-list">
    {
      honors.map((honor) => (
        <li>
          {honor.year && <><span class="term">{honor.year}</span>{" - "}</>}
          <span class="term">{honor.title}</span>
          {honor.detail ? ` - ${honor.detail}` : "."}
        </li>
      ))
    }
  </ul>

  <h2 class="section__title" id="now">&#128205; Now</h2>
  <div class="prose">
    <p>
      I am looking for AI research and engineering internships around multimodal
      learning, LLM reasoning, research agents, and evaluation-heavy systems. I
      am easiest to reach by <a href={site.links.email}>email</a> or on{" "}
      <a href={site.links.github}>GitHub</a>.
    </p>
    <ul class="tag-row">
      {skills.map((skill) => <li class="tag">{skill}</li>)}
    </ul>
  </div>
</BaseLayout>
