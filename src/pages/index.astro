---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProfilePanel from "@components/ProfilePanel.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { featuredProjects } from "@data/projects";
import { site } from "@data/site";
---

<BaseLayout>
  <section class="home-layout">
    <ProfilePanel />

    <div class="home-feed">
      <section class="hero-copy reveal reveal-delay-1">
        <p class="eyebrow">AI Explorer / Researcher / Builder</p>
        <h2>I chase the moment when models stop guessing and start <em>grounding.</em></h2>
        <p class="hero-lede">
          I am a software engineering undergraduate at Tongji University, exploring how AI systems
          listen, look, reason, and revise. My work moves between multimodal
          perception, reasoning behavior, and tools for better research workflows.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="button button-primary" href="/research/">Explore my research</a>
          <a class="button button-quiet" href="/about/">A little more about me</a>
        </div>
      </section>

      <section class="home-section reveal reveal-delay-2">
        <div class="section-heading">
          <div>
            <p class="eyebrow">What keeps me curious</p>
            <h2>Three threads, one question: what did the model actually notice?</h2>
          </div>
        </div>
        <div class="interest-list">
          <article>
            <span>01</span>
            <h3>Listen to motion</h3>
            <p>Use audio and movement together to find what is genuinely making sound.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Spend thought wisely</h3>
            <p>Study when more reasoning helps, and when it only adds confident drift.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Build visible tools</h3>
            <p>Make AI research workflows inspectable, editable, and easier to trust.</p>
          </article>
        </div>
      </section>

      <section class="home-section">
        <div class="section-heading reveal">
          <div>
            <p class="eyebrow">Selected work</p>
            <h2>Research ideas that became working systems.</h2>
          </div>
          <a class="text-link" href="/projects/">All projects</a>
        </div>
        <div class="project-list">
          {featuredProjects.map((project, index) => <ProjectCard project={project} index={index} compact />)}
        </div>
      </section>

      <section class="now-strip reveal">
        <div>
          <p class="eyebrow">Open to good problems</p>
          <h2>Looking for AI research and engineering internships.</h2>
        </div>
        <p>
          Especially multimodal systems, LLM reasoning, research agents, and
          teams that care about evaluation as much as the demo.
        </p>
        <a class="button button-inverse" href={site.links.email}>Start a conversation</a>
      </section>
    </div>
  </section>
</BaseLayout>
