---
import BaseLayout from "@layouts/BaseLayout.astro";
import Entry from "@components/Entry.astro";
import Icon from "@components/Icon.astro";
import { site } from "@data/site";
import { education, honors, interests } from "@data/profile";
import { news } from "@data/news";
import { publicationGroups, publicationLegend } from "@data/publications";
import { projects } from "@data/projects";

const [tongji, sjtu, sii] = site.affiliations;
const interestList =
  interests.slice(0, -1).join(", ") + ", and " + interests[interests.length - 1];
---

<BaseLayout>
  <h1 class="page__title" id="about">&#128173; About me</h1>
  <div class="prose">
    <p>
      I am an undergraduate student in Software Engineering at{" "}
      <a href={tongji.url}>{tongji.name}</a> and an incoming Ph.D. student at{" "}
      <a href={sjtu.url}>{sjtu.name}</a>, jointly trained at{" "}
      <a href={sii.url}>{sii.name}</a>. My research interests include{" "}
      {interestList}.
    </p>
  </div>

  <h2 class="section__title" id="education">&#128214; Education</h2>
  <div class="prose">
    <ul>
      {
        education.map((entry) => (
          <li>
            {entry.period}: {entry.degree},{" "}
            {entry.institutionUrl ? (
              <a href={entry.institutionUrl}>{entry.institution}</a>
            ) : (
              entry.institution
            )}.
          </li>
        ))
      }
    </ul>
  </div>

  <h2 class="section__title" id="news">&#128293; News</h2>
  <div class="prose">
    <ul>
      {
        news.map((item) => (
          <li>
            [{item.date}]{" "}
            {item.href ? (
              <a class="news-highlight" href={item.href}>{item.highlight}</a>
            ) : (
              <span class="news-highlight">{item.highlight}</span>
            )}{" "}
            {item.body}
          </li>
        ))
      }
    </ul>
  </div>

  <h2 class="section__title" id="publications">
    <span>&#128221; Publications</span>
    <span class="publication-legend">{publicationLegend}</span>
  </h2>
  {
    publicationGroups.map((group) => (
      <>
        <h3 class="group__title">{group.heading}</h3>
        {group.entries.map((entry) => (
          <Entry
            title={entry.title}
            href={entry.href}
            authors={entry.authors}
            venue={entry.venue}
            links={entry.links}
            image={entry.image}
          />
        ))}
      </>
    ))
  }

  <h2 class="section__title" id="projects">&#128640; Projects</h2>
  {
    projects.map((project) => (
      <Entry
        title={project.title}
        href={project.repo}
        venue={`${project.period} · ${project.role} · ${project.status}`}
        summary={project.summary}
        links={[{ label: "Code", href: project.repo }, ...(project.links ?? [])]}
        image={project.image}
      />
    ))
  }

  <h2 class="section__title" id="honors">&#127894; Honors and Awards</h2>
  <ul class="award-list">
    {
      honors.map((honor) => (
        <li class="award">
          <span class={`award__badge award__badge--${honor.kind}`}>
            <Icon name={honor.kind === "scholarship" ? "medal" : "star"} />
          </span>
          <span class="award__body">
            <span class="award__title">{honor.title}</span>
            {honor.org && <span class="award__org">{honor.org}</span>}
          </span>
          {honor.year && <span class="award__year">{honor.year}</span>}
        </li>
      ))
    }
  </ul>
</BaseLayout>
