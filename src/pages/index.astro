---
import BaseLayout from "@layouts/BaseLayout.astro";
import LabBoard from "@components/LabBoard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { featuredProjects } from "@data/projects";
import { site } from "@data/site";
---

<BaseLayout>
  <section class="hero-section">
    <div class="hero-copy">
      <p class="eyebrow">Haojie Hu / AI Explorer</p>
      <h1>I build multimodal systems and research tools for messy evidence.</h1>
      <p class="hero-lede">
        I am a Software Engineering undergraduate at Tongji University, exploring
        audio-visual perception, reasoning budgets, and AI workflows that make
        research easier to inspect, revise, and share.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href="/research/">Read the research</a>
        <a class="button button-secondary" href="/projects/">Browse projects</a>
      </div>
    </div>
    <LabBoard />
  </section>

  <section class="section-block split-block">
    <div>
      <p class="eyebrow">What I care about</p>
      <h2>Systems that know when to look, listen, think, and revise.</h2>
    </div>
    <div class="interest-list">
      <p><strong>Multimodal perception.</strong> Ground objects and events across audio, vision, motion, and language.</p>
      <p><strong>Reasoning behavior.</strong> Study when longer reasoning helps and when it creates drift.</p>
      <p><strong>Research tooling.</strong> Build pipelines that turn papers, experiments, and posters into inspectable artifacts.</p>
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <p class="eyebrow">Selected work</p>
      <h2>Research and software with a little personality.</h2>
      <a class="text-link" href="/projects/">See all projects</a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-block now-strip">
    <div>
      <p class="eyebrow">Now</p>
      <h2>Currently looking for research and engineering internship opportunities in AI.</h2>
    </div>
    <p>
      Best fit: multimodal systems, LLM reasoning, agents for research workflows,
      and teams that care about evaluation rather than just demos.
    </p>
    <a class="button button-secondary" href={site.links.github}>GitHub</a>
  </section>
</BaseLayout>
