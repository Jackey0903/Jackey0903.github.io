---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import Icon from "@components/Icon.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const notePath = (id: string) => id.replace(/\.md$/, "");
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(date);
---

<BaseLayout
  title="Notes"
  description="Short research notes and essays by Haojie Hu."
>
  <h1 class="page__title">&#128221; Notes</h1>
  <div class="prose">
    <p>
      Short writing on papers, experiments, research questions, and the
      engineering decisions behind AI systems.
    </p>
  </div>

  {
    notes.map((note) => (
      <a class="note-card" href={`/notes/${notePath(note.id)}/`}>
        <span class="note-card__meta">
          {note.data.category} &middot; {formatDate(note.data.date)}
        </span>
        <h2 class="note-card__title">{note.data.title}</h2>
        <p class="note-card__excerpt">{note.data.excerpt}</p>
      </a>
    ))
  }

  <p class="prose">
    <a class="text-link" href="/">Back to homepage <Icon name="arrow" /></a>
  </p>
</BaseLayout>
