---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/PageIntro.astro";
import NoteCard from "@components/NoteCard.astro";

const notes = (await getCollection("notes")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const notePath = (id: string) => id.replace(/\.md$/, "");
---

<BaseLayout title="Notes" description="Research notes and short essays by Haojie Hu.">
  <PageIntro
    eyebrow="Notes"
    title="Field notes, before the ideas become too tidy."
    copy="Short writing about research taste, engineering habits, and the small decisions that quietly shape AI projects."
  />

  <section class="notes-grid">
    {
      notes.map((note) => (
        <NoteCard
          href={`/notes/${notePath(note.id)}/`}
          title={note.data.title}
          date={note.data.date}
          category={note.data.category}
          excerpt={note.data.excerpt}
        />
      ))
    }
  </section>
</BaseLayout>
