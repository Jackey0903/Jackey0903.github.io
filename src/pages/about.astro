---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/PageIntro.astro";
import { site } from "@data/site";
---

<BaseLayout title="About / Now" description="About Haojie Hu and current interests.">
  <PageIntro
    eyebrow="About / Now"
    title="About / Now"
    copy="I am a software engineering undergraduate at Tongji University, working across AI research and engineering. This page records what I am focusing on now."
  />

  <section class="about-grid">
    <article class="about-panel reveal">
      <p class="section-number">Current focus</p>
      <h2>Right now</h2>
      <ul class="check-list">
        <li>Studying audio-visual segmentation through motion and physical consistency.</li>
        <li>Testing when LLM reasoning budgets help multimodal grounding.</li>
        <li>Building agent workflows for paper understanding and poster generation.</li>
      </ul>
    </article>

    <article class="about-panel reveal">
      <p class="section-number">Opportunities</p>
      <h2>What I am looking for</h2>
      <p>
        Research or engineering internships around multimodal learning, LLM
        reasoning, AI agents, research tooling, or evaluation-heavy AI systems.
      </p>
    </article>

    <article class="about-panel reveal">
      <p class="section-number">Working style</p>
      <h2>How I work</h2>
      <ul class="check-list">
        <li>Start with a small working loop, then inspect the failure cases.</li>
        <li>Prefer readable pipelines over magic one-shot demos.</li>
        <li>Write notes because half of research is remembering why a choice mattered.</li>
      </ul>
    </article>

    <article class="about-panel reveal">
      <p class="section-number">Beyond research</p>
      <h2>Still a person</h2>
      <p>
        I enjoy playful systems, game mechanics, and projects that teach me a
        new way to look at a familiar problem. Curiosity is part of the method.
      </p>
    </article>
  </section>

  <section class="contact-panel reveal">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Research, internships, and collaboration</h2>
    </div>
    <div>
      <p>I am easiest to reach by email or GitHub. Clear context is always appreciated.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={site.links.email}>Email me</a>
        <a class="button button-quiet" href={site.links.github}>GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
