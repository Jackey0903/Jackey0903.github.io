---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageIntro from "@components/PageIntro.astro";
import { site } from "@data/site";
---

<BaseLayout title="Now" description="Current research interests and opportunities for Haojie Hu.">
  <PageIntro
    eyebrow="Current"
    title="Now"
    copy="A concise record of my current research focus, working approach, and the opportunities I am seeking."
  />

  <div class="now-sections">
    <section class="now-section reveal">
      <h2>Current Research</h2>
      <ul>
        <li>Studying audio-visual segmentation through motion and physical consistency.</li>
        <li>Testing when reasoning budgets improve multimodal grounding.</li>
        <li>Building agent workflows for paper understanding and scientific communication.</li>
      </ul>
    </section>

    <section class="now-section reveal">
      <h2>Research Approach</h2>
      <p>
        I begin with a small reproducible loop, inspect failure cases, and expand only
        when the evidence supports it. I value readable pipelines, explicit evaluation,
        and intermediate artifacts that make model behavior easier to question.
      </p>
    </section>

    <section class="now-section reveal">
      <h2>Opportunities</h2>
      <p>
        I am seeking research or engineering internships in multimodal learning,
        LLM reasoning, AI agents, research tooling, and evaluation-focused AI systems.
      </p>
    </section>

    <section class="now-section reveal">
      <h2>Beyond Research</h2>
      <p>
        I enjoy game systems, practical software projects, and learning through
        building. These projects keep my engineering work concrete and playful.
      </p>
    </section>
  </div>

  <section class="contact-panel reveal">
    <div>
      <p class="eyebrow">Contact</p>
      <h2>Research, internships, and collaboration</h2>
    </div>
    <div>
      <p>I am easiest to reach by email or GitHub.</p>
      <div class="hero-actions">
        <a class="button button-primary" href={site.links.email}>Email me</a>
        <a class="button button-quiet" href={site.links.github}>GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
