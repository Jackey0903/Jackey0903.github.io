---
import type { ResearchThread } from "@data/research";

type Props = {
  thread: ResearchThread;
};

const { thread } = Astro.props;
---

<article class="research-thread">
  <p class="eyebrow">{thread.eyebrow}</p>
  <h2>{thread.title}</h2>
  <div class="thread-grid">
    <section>
      <h3>Question</h3>
      <p>{thread.problem}</p>
    </section>
    <section>
      <h3>Approach</h3>
      <p>{thread.approach}</p>
    </section>
    <section>
      <h3>Status</h3>
      <p>{thread.status}</p>
    </section>
  </div>
  <div class="thread-footer">
    <ul class="tag-list">
      {thread.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {thread.link && <a class="text-link" href={thread.link}>View repository</a>}
  </div>
</article>
