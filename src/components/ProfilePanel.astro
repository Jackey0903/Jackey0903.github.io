---
import { ArrowUpRight, GitBranch, GraduationCap, Mail, MapPin } from "@lucide/astro";
import { site } from "@data/site";
---

<aside class="profile-panel reveal" aria-label={`${site.name} profile`}>
  <div class="portrait-wrap">
    <img class="portrait" src={site.portrait} alt={`${site.name}, AI explorer`} />
    <span class="portrait-caption">curious on purpose</span>
  </div>

  <div class="profile-intro">
    <p class="kicker">Hello, I am</p>
    <h1>{site.name}</h1>
    <p class="profile-role">{site.role}</p>
  </div>

  <div class="profile-facts">
    <a href={site.links.tongji}>
      <GraduationCap size={17} stroke-width={1.8} aria-hidden="true" />
      <span>{site.affiliation}</span>
    </a>
    <span>
      <MapPin size={17} stroke-width={1.8} aria-hidden="true" />
      <span>{site.location}</span>
    </span>
  </div>

  <p class="profile-note">
    I like models that can explain what evidence they trusted, and tools that
    leave enough clues for humans to disagree.
  </p>

  <div class="profile-links">
    <a href={site.links.github}>
      <GitBranch size={18} stroke-width={1.8} aria-hidden="true" />
      GitHub
      <ArrowUpRight class="link-arrow" size={15} stroke-width={1.8} aria-hidden="true" />
    </a>
    <a href={site.links.email}>
      <Mail size={18} stroke-width={1.8} aria-hidden="true" />
      Email
      <ArrowUpRight class="link-arrow" size={15} stroke-width={1.8} aria-hidden="true" />
    </a>
  </div>

  <div class="interest-cloud" aria-label="Research interests">
    <span>Multimodal Learning</span>
    <span>LLM Reasoning</span>
    <span>AI for Research</span>
  </div>
</aside>
