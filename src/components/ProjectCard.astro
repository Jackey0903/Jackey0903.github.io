---
import type { Project } from "@data/projects";
import { ArrowUpRight } from "@lucide/astro";

type Props = {
  project: Project;
  compact?: boolean;
};

const { project, compact = false } = Astro.props;
---

<article class:list={["project-card reveal", compact && "project-card-compact", project.visual && !compact && "has-visual"]}>
  {
    project.visual && !compact && (
      <div class="project-media">
        <img
          class="project-visual"
          src={project.visual.src}
          alt={project.visual.alt}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="project-content">
    <div class="project-meta">
      <span>{project.role}</span>
      <span>{project.period}</span>
    </div>
    <h2><a href={project.repo}>{project.title}</a></h2>
    <p class="subtitle">{project.subtitle}</p>
    <p>{project.summary}</p>
    <ul class="tag-list" aria-label={`${project.title} tags`}>
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    {
      !compact && (
        <ul class="check-list">
          {project.highlights.map((item) => <li>{item}</li>)}
        </ul>
      )
    }
    <div class="project-footer">
      <span class="project-status">{project.status}</span>
      <a class="project-link" href={project.repo} aria-label={`Open ${project.title} repository`}>
        Repository <ArrowUpRight size={15} stroke-width={1.8} aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
