---
import { navItems, site } from "@data/site";
import { Moon, Sun } from "@lucide/astro";

type Props = {
  pathname: string;
};

const { pathname } = Astro.props;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
};
---

<header class="site-header-wrap">
  <div class="site-header site-shell">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-name">{site.name}</span>
      <span class="brand-separator">/</span>
      <span class="brand-role">AI Explorer</span>
    </a>
    <div class="header-actions">
      <nav class="nav-links" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a href={item.href} class:list={[isActive(item.href) && "active"]}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
        <Sun class="theme-icon theme-icon-sun" size={18} stroke-width={1.8} aria-hidden="true" />
        <Moon class="theme-icon theme-icon-moon" size={18} stroke-width={1.8} aria-hidden="true" />
      </button>
    </div>
  </div>
</header>
