---
type Props = {
  eyebrow: string;
  title: string;
  copy: string;
};

const { eyebrow, title, copy } = Astro.props;
const showEyebrow = eyebrow.toLowerCase() !== title.toLowerCase();
---

<section class="page-intro reveal">
  {showEyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p>{copy}</p>
</section>
